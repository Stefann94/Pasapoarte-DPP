{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "regions": ["fra1"],
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "src/**",
      "excludeFiles": "node_modules/@electric-sql/**"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }]
}
