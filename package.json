    "bench": "node scripts/bench.js",
    "test": "node --test test/",
    "provision": "node scripts/provision.js"
  },
  "dependencies": {
    "pg": "^8.23.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16"
  }
}
