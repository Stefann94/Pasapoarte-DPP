# Copy to .env and change the values.

# Platform administrator token (min. 24 characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_TOKEN=change-me-to-a-long-random-secret-value

PORT=3000

# Public base URL used in passport links / QR codes. In production this must be
# a stable domain you control long-term (e.g. https://passport.example.eu).
BASE_URL=http://localhost:3000

# Where the SQLite database and document blobs are stored.
DATA_DIR=./data

# Set to 1 only when running behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=0

MAX_DOCUMENT_MB=25
RATE_LIMIT_PER_MINUTE=600
