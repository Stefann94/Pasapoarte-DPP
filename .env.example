# Copy to .env for local use. On Vercel, set the same variables in
# Project Settings -> Environment Variables. Never commit real values.

# Platform administrator token (min. 24 characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_TOKEN=change-me-to-a-long-random-secret-value

# ---- Supabase (production). Leave empty locally to use a built-in PGlite database.
# Supabase -> Project Settings -> Database -> Connection string -> "Transaction pooler" (port 6543)
DATABASE_URL=
# Supabase -> Project Settings -> API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=dpp-documents

# Public base URL used in passport links / QR codes. On Vercel it defaults to the
# production domain. Long term this must be a stable domain you control.
BASE_URL=http://localhost:3000

PORT=3000
DATA_DIR=./data
TRUST_PROXY=0
MAX_DOCUMENT_MB=25
RATE_LIMIT_PER_MINUTE=600
